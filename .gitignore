# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# local data (sqlite db, encryption key)
/data/

# claude code config + session artifacts (per-developer, not shared)
/.claude/
/.superpowers/

# menu bar app build outputs
/menubar/.build/
/menubar/build/
/menubar/.swiftpm/
/menubar/Package.resolved

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/transactions
# Local test scripts
scripts/test-*
!scripts/test-import-detection.mjs
!scripts/test-import-preview-orchestration.mjs
!scripts/test-trips.mjs
!scripts/test-trips-db.mjs
!scripts/test-service-windows.mjs
!scripts/test-phone-sync-*.mjs
/out-mobile/
/.mobile-build/

# Temp databases for tests and demo seeds
.tmp-tests/

# Android companion (Capacitor). android/ is committed; its build outputs,
# signing material and local SDK paths are not. android/.gitignore also
# covers the generated capacitor.config.json and plugin lists.
!.env.mobile.example
.env.mobile
/android/build/
/android/app/build/
/android/.gradle/
/android/app/release/
/android/local.properties
/android/app/src/main/assets/public/
/android/app/google-services.json
*.jks
*.keystore
